#!/bin/bash

slurp_args="$1"
image_lib="${2:-png}"

copypl() {
    if [ "$image_lib" != "png" ]; then
        ffmpeg -i - -c:v "$image_lib" -f image2pipe - | wl-copy -t image/png
    else
        wl-copy -t image/png
    fi
}

if [ -z "$SCREENSHOT_OUTPUT" ]; then
    pos=${SCREENSHOT_POS:-$(slurp "$slurp_args")}
    grim -t png -g "$pos" /dev/stdout
else
    grim -t png -o "$SCREENSHOT_OUTPUT" /dev/stdout
fi | copypl

year="$(date +%Y)"

t="$XDG_PICTURES_DIR/screenshots/$year"
! [ -d "$t" ] && mkdir -p "$t"

case "$image_lib" in
    libjxl) ext="jxl" ;;
    png) ext="png" ;;
esac

t="${t}/Screenshot_${USER}-$(uname)_$(date +%Y%m%d-%H%M%S).${ext}"

wl-paste > "$t"

exifDate=$(date "+%Y:%m:%d %H:%M:%S")
exiftool -overwrite_original "-alldates=${exifDate}" "$t"

notify-send -c screenshot -i "$t" "Image taken at: $pos"

if [ "$3" = "no-save" ]; then
    rm "$t"
fi
